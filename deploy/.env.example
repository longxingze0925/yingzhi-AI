SHADOWWEAVE_WEB_IMAGE=ghcr.io/your-github-user/your-repo-web:latest
SHADOWWEAVE_HTTP_PORT=80

# 影织 Web 的反向代理使用 New API；上游地址不传给浏览器。
NEW_API_UPSTREAM=https://new.0000.icu
# nginx.conf 中的 $new_api_host 应与此值一致，用于 Host 与 TLS SNI。
NEW_API_HOST=new.0000.icu

# Web 构建参数
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_DEMO_FALLBACK=0

# New API 开启安全刷新 Cookie 时，还需在 New API 服务端把影织公网 Origin
# 加入 SESSION_COOKIE_TRUSTED_URL，例如 https://studio.example.com。
